# ==============================================================================
# PrimeSoul School ERP - Environment Variables Template
# Copy this file to .env (or /etc/primesoul/.env) and populate before deployment.
# NEVER commit actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=your_secret_key_here_minimum_64_characters
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ADMIN_URL=admin

# Allowed Hosts & CSRF Origins (Comma-separated)
ALLOWED_HOSTS=primesoul.com,www.primesoul.com,.primesoul.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://primesoul.com,https://www.primesoul.com,https://*.primesoul.com,http://localhost:8000

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/primesoul_erp
DB_NAME=primesoul_erp
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. REDIS & CACHING CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CELERY BACKGROUND WORKER CONFIGURATION
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. SECURITY & HTTPS HEADERS
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://primesoul.com,https://www.primesoul.com,https://*.primesoul.com

# ------------------------------------------------------------------------------
# 6. STATIC & MEDIA STORAGE
# ------------------------------------------------------------------------------
STATIC_ROOT=/var/www/primesoul/staticfiles
MEDIA_ROOT=/var/www/primesoul/media
STATIC_URL=/static/
MEDIA_URL=/media/

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATION PROVIDER (SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=PrimeSoul ERP <no-reply@primesoul.com>

# ------------------------------------------------------------------------------
# 8. INDIAN SMS PROVIDER (DLT COMPLIANT)
# ------------------------------------------------------------------------------
SMS_PROVIDER=msg91  # Supported: msg91, textlocal, twilio, mock
SMS_AUTH_KEY=your_sms_auth_key
SMS_SENDER_ID=PRSOUL
SMS_DLT_ENTITY_ID=your_dlt_entity_id

# ------------------------------------------------------------------------------
# 9. WHATSAPP BUSINESS API PROVIDER
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta_cloud  # Supported: meta_cloud, twilio, gupshup, mock
WHATSAPP_API_KEY=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
USE_PAYMENT_OPTIONS=True
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

USE_STRIPE=False
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 11. ERROR MONITORING & SENTRY (OPTIONAL)
# ------------------------------------------------------------------------------
USE_SENTRY=False
SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=0.2

